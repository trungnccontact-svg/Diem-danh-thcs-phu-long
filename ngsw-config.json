{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js", "/manifest.webmanifest", "/school-gate.jpg"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "firebase-realtime",
      "urls": ["https://*.firebaseio.com/**"],
      "cacheConfig": { "maxSize": 50, "maxAge": "1h", "timeout": "10s", "strategy": "freshness" }
    }
  ]
}
